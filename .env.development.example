# Every value below is also the built-in development default; copy this file only
# to change one. Staging and production must declare all of them (startup refuses otherwise).
API_VERSION=v1
IP_MONGO_DB=127.0.0.1
PORT_MONGO_DB=27019
DB_NAME=dtpf
PORT_SERVER=3998
# SMTP: with SMTP_USER empty, contact notifications are skipped instead of failing.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=contacto@dtpf.es
NOTIFICATION_TO=dtpf@dtpf.es
