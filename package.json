{
  "name": "dtpf-api",
  "version": "0.1.21",
  "description": "Contact-form API behind dtpf.es, the personal portfolio of David T. Pizarro Frick",
  "main": "dist/index.js",
  "author": "David T. Pizarro Frick",
  "license": "MIT",
  "homepage": "https://dtpf.es",
  "repository": {
    "type": "git",
    "url": "https://github.com/dtpf-apps/dtpf-api.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mongoose": "^9.10.4",
    "nodemailer": "^10.0.14",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "~24.19.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "~8.3.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "db": "docker start dtpf-mongodb",
    "dev": "NODE_ENV=development concurrently \"tsc --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/index.js\"",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json,md}\""
  },
  "prettier": {
    "printWidth": 110,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2
  }
}
