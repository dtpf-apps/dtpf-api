{
  "name": "dtpf-portfolio-backend",
  "version": "0.0.1",
  "description": "Backend para portafolio personal",
  "main": "dist/index.js",
  "author": "David Thomas Pizarro Frick",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.17.1",
    "jwt-simple": "^0.5.6",
    "moment": "^2.29.1",
    "mongoose": "^9.2.3",
    "mongoose-paginate-v2": "^1.9.1",
    "multer": "^2.0.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jwt-simple": "^0.5.36",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.2",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "db": "docker start dtpf-mongodb",
    "dev": "NODE_ENV=development concurrently \"tsc --watch\" \"nodemon dist/index.js\"",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json,md}\""
  },
  "prettier": {
    "printWidth": 110,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2
  }
}