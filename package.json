{
  "name": "dtpf-api",
  "version": "0.1.13",
  "description": "Backend para portafolio personal",
  "main": "dist/index.js",
  "author": "David Thomas Pizarro Frick",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.7.4",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "~24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "db": "docker start dtpf-mongodb",
    "dev": "NODE_ENV=development concurrently \"tsc --watch\" \"nodemon dist/index.js\"",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json,md}\""
  },
  "prettier": {
    "printWidth": 110,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2
  }
}
