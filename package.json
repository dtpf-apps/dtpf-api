{
  "name": "dtpf-api",
  "version": "0.2.0",
  "description": "Contact-form API behind dtpf.es, the personal portfolio of David T. Pizarro Frick",
  "main": "dist/index.js",
  "author": "David T. Pizarro Frick",
  "license": "MIT",
  "homepage": "https://dtpf.es",
  "repository": {
    "type": "git",
    "url": "https://github.com/dtpf-apps/dtpf-api.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "mongoose": "^9.11.2",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "~24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "~8.3.4",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "db": "docker start dtpf-mongodb",
    "dev": "NODE_ENV=development concurrently \"tsc --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/index.js\"",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "prettier": {
    "printWidth": 110,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2
  }
}
