{
  "name": "dtpf-portfolio-backend",
  "version": "0.0.1",
  "description": "Backend para portafolio personal",
  "main": "dist/index.js",
  "author": "David Thomas Pizarro Frick",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dauth-md-node": "^4.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "mongoose": "^9.2.3",
    "mongoose-paginate-v2": "^1.9.1",
    "multer": "^2.1.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.3.3",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "db": "docker start dtpf-mongodb",
    "dev": "NODE_ENV=development concurrently \"tsc --watch\" \"nodemon dist/index.js\"",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/index.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,json,md}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "sharp"
    ]
  },
  "prettier": {
    "printWidth": 110,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "tabWidth": 2
  }
}