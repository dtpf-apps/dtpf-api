API_VERSION=v1
IP_MONGO_DB=db-server-ip
PORT_MONGO_DB=27017
DB_NAME=dtpf
PORT_SERVER=3998
# SMTP (Stalwart Mail Server). STARTTLS is mandatory and the certificate is always verified.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=contacto
SMTP_PASS=smtp-password
# Required when SMTP_HOST is an IP address: the hostname the certificate was issued for.
# SMTP_TLS_SERVERNAME=mail.example.com
EMAIL_FROM=contacto@dtpf.es
NOTIFICATION_TO=dtpf@dtpf.es
